# --- PostgreSQL ---
# Superuser/app username Postgres creates on first boot
POSTGRES_USER=youmart_dev
# Superuser/app password - placeholder only, never commit a real secret here
POSTGRES_PASSWORD=changeme_dev_password
# Default database created on first boot
POSTGRES_DB=youmart_dev
# Host port mapped to the Postgres container's 5432 (5433 - not 5432 - to avoid clashing with a native Windows PostgreSQL install already using 5432 on this machine)
POSTGRES_PORT=5433
# Full Prisma connection string for the local Postgres container (schema=public is the default connection schema; multiSchema tables live in their own named schemas)
DATABASE_URL=postgresql://youmart_dev:changeme_dev_password@localhost:5433/youmart_dev?schema=public

# --- Redis ---
# Host port mapped to the Redis container's 6379
REDIS_PORT=6379
# Hostname the queue's ioredis client connects to
REDIS_HOST=localhost
# Full Redis connection URL; if set, takes precedence over REDIS_HOST/REDIS_PORT
REDIS_URL=redis://localhost:6379

# --- Typesense ---
# API key Typesense requires on every request - placeholder only
TYPESENSE_API_KEY=changeme_dev_typesense_key
# Host port mapped to the Typesense container's 8108
TYPESENSE_PORT=8108

# --- Auth service ---
# Port the auth service listens on
PORT=4001
# Connection string using the least-privilege auth_svc role (Ch2 grants),
# scoped to the auth schema only - not the owner DATABASE_URL
AUTH_DATABASE_URL=postgresql://auth_svc:auth_svc_dev_pw@localhost:5433/youmart_dev?schema=auth
# OTP request/verify tuning (all optional, shown defaults)
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_PER_HOUR=5
# HMAC key for hashing OTP codes - placeholder only; production value is a deploy-chapter secret
OTP_HASH_SECRET=changeme_dev_otp_hash_secret_key

# --- Auth service: JWT (RS256) ---
# Generate a dev keypair and base64-encode each PEM onto a single line:
#   node -e "const {generateKeyPairSync}=require('node:crypto');const {publicKey,privateKey}=generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log('JWT_PRIVATE_KEY='+Buffer.from(privateKey).toString('base64'));console.log('JWT_PUBLIC_KEY='+Buffer.from(publicKey).toString('base64'));"
# Never commit real keys - this file only holds placeholders.
JWT_PRIVATE_KEY=changeme_base64_encoded_rsa_private_key_pem
JWT_PUBLIC_KEY=changeme_base64_encoded_rsa_public_key_pem
JWT_ISSUER=youmart-auth
JWT_AUDIENCE=youmart
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
REFRESH_COOKIE_NAME=ym_rt
# true in every non-dev environment
COOKIE_SECURE=false
# empty in dev; set to the real apex domain in prod
COOKIE_DOMAIN=

# --- Catalog service ---
# Port the catalog service listens on. Named CATALOG_PORT (not PORT) since
# this repo shares one root .env across services - PORT=4001 is already
# taken by the auth service
CATALOG_PORT=4002
# Connection string using the least-privilege catalog_svc role (Ch2 grants),
# scoped to the catalog schema only - not the owner DATABASE_URL
CATALOG_DATABASE_URL=postgresql://catalog_svc:catalog_svc_dev_pw@localhost:5433/youmart_dev?schema=catalog
# Base URL prepended to stored image paths/keys to build absolute URLs -
# never hardcode a CDN domain in code (e.g. https://cdn.youmart.in in prod)
CDN_BASE_URL=http://localhost:4002
# Hard-off multivendor: every product created by the write API is owned by
# this one default seller. catalog_svc cannot read the sellers schema
# (cross-schema isolation by design) - this id was looked up once via the
# owner role and injected here instead of being queried at runtime. Also
# used by scripts/seed-catalog-dev.ts.
DEFAULT_SELLER_ID=changeme_default_seller_uuid
# Injected for now because catalog_svc cannot read admin.marketplace_settings;
# Ch6 replaces this with a real lookup once sellers/admin exist. Always
# DISABLED (hard-off) today - no real sellers can register.
MARKETPLACE_MODE=DISABLED
# TEMPORARY dev-only catalog-write authorization gate (comma-separated user
# ids allowed to manage the catalog) - replaced by real RBAC in Ch6. Empty by
# default = no one can write; add a user id here to test write endpoints.
ADMIN_USER_IDS=

# --- Inventory service ---
# Port the inventory service listens on. Named INVENTORY_PORT (not PORT) for
# the same shared-root-.env reason as CATALOG_PORT.
INVENTORY_PORT=4003
# Connection string using the least-privilege inventory_svc role (Ch2
# grants), scoped to the inventory schema only - not the owner DATABASE_URL
INVENTORY_DATABASE_URL=postgresql://inventory_svc:inventory_svc_dev_pw@localhost:5433/youmart_dev?schema=inventory
# Reuses the SAME TEMPORARY manager gate as catalog-service's ADMIN_USER_IDS
# above (shared root .env, same variable name) - both are replaced by real
# per-resource RBAC in Ch6.

# --- Cart service ---
# Port the cart service listens on. Named CART_PORT (not PORT) for the same
# shared-root-.env reason as CATALOG_PORT/INVENTORY_PORT.
CART_PORT=4004
# Connection string using the least-privilege cart_svc role (Ch2 grants),
# scoped to the cart schema only - not the owner DATABASE_URL
CART_DATABASE_URL=postgresql://cart_svc:cart_svc_dev_pw@localhost:5433/youmart_dev?schema=cart
# cart_svc cannot read catalog/inventory schemas (cross-schema isolation) -
# SKU/price and stock data come over HTTP via @youmart/service-client.
CATALOG_SERVICE_URL=http://localhost:4002
INVENTORY_SERVICE_URL=http://localhost:4003
# Per-call timeout (AbortController) for all outgoing service-to-service
# HTTP calls made via @youmart/service-client.
SERVICE_HTTP_TIMEOUT_MS=5000

# --- Order service ---
# Port the order service listens on. Named ORDER_PORT (not PORT) for the
# same shared-root-.env reason as CART_PORT/CATALOG_PORT/INVENTORY_PORT.
ORDER_PORT=4005
# Connection string using the least-privilege orders_svc role (Ch2 grants),
# scoped to the orders schema only - not the owner DATABASE_URL
ORDER_DATABASE_URL=postgresql://orders_svc:orders_svc_dev_pw@localhost:5433/youmart_dev?schema=orders
# orders_svc cannot read cart/catalog/inventory schemas (cross-schema
# isolation) - cart contents, authoritative prices, and stock all come over
# HTTP via @youmart/service-client.
CART_SERVICE_URL=http://localhost:4004
# orders_svc cannot read the addresses schema (cross-schema isolation) -
# checkout validates + snapshots the caller's chosen shipping address over
# HTTP via @youmart/service-client (Ch6.1).
ADDRESS_SERVICE_URL=http://localhost:4011
# orders_svc cannot read the auth schema (cross-schema isolation) -
# resolving the buyer's email for the order-confirmation notification
# (Ch6.2) goes over HTTP too.
AUTH_SERVICE_URL=http://localhost:4001

# --- Payment service ---
# Port the payment service listens on. Named PAYMENT_PORT (not PORT) for
# the same shared-root-.env reason as the other services' <X>_PORT vars.
PAYMENT_PORT=4006
# Connection string using the least-privilege payments_svc role (Ch2
# grants), scoped to the payments schema only - not the owner DATABASE_URL
PAYMENT_DATABASE_URL=postgresql://payments_svc:payments_svc_dev_pw@localhost:5433/youmart_dev?schema=payments
# payments_svc cannot read the orders schema (cross-schema isolation) -
# order lookup/confirm/cancel all go over HTTP via @youmart/service-client.
ORDER_SERVICE_URL=http://localhost:4005
# Razorpay TEST-mode keys (from the Razorpay dashboard) - set your own test
# keys locally; never commit real values.
RAZORPAY_KEY_ID=changeme_razorpay_test_key_id
RAZORPAY_KEY_SECRET=changeme_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=changeme_razorpay_webhook_secret

# --- Seller service ---
# Port the seller service listens on. Named SELLER_PORT (not PORT) for the
# same shared-root-.env reason as the other services' <X>_PORT vars.
SELLER_PORT=4007
# Connection string using the least-privilege sellers_svc role (Ch2
# grants), scoped to the sellers schema only - not the owner DATABASE_URL
SELLER_DATABASE_URL=postgresql://sellers_svc:sellers_svc_dev_pw@localhost:5433/youmart_dev?schema=sellers
# Default commission (percent, Decimal(5,2) at the DB layer) applied to a
# newly-registered (non-default) seller.
DEFAULT_COMMISSION_PERCENT=10.00
# HMAC key used to hash bank account numbers before they ever reach the
# database - same discipline as auth-service's OTP_HASH_SECRET. Never the
# raw account number is stored/logged, only this hash's output.
BANK_ACCOUNT_HASH_SECRET=changeme_dev_bank_account_hash_secret_key
# Reuses the SAME shared MARKETPLACE_MODE/ADMIN_USER_IDS keys declared
# above (catalog-service's block) - sellers_svc cannot read
# admin.marketplace_settings (cross-schema isolation), so the hard-off mode
# is injected the same temporary way; seller admin approval reuses the same
# temporary manager allow-list as catalog/inventory.
# catalog_svc/orders_svc cannot read the sellers schema (cross-schema
# isolation) - "who owns this caller's seller, and are they active" is
# resolved over HTTP against this URL (Ch5.2 seller-scoped endpoints).
SELLER_SERVICE_URL=http://localhost:4007

# --- Settlement service ---
# Port the settlement service listens on. Named SETTLEMENT_PORT (not PORT)
# for the same shared-root-.env reason as the other services' <X>_PORT vars.
SETTLEMENT_PORT=4008
# Connection string using the least-privilege settlements_svc role (Ch2
# grants), scoped to the settlements schema only - not the owner DATABASE_URL
SETTLEMENT_DATABASE_URL=postgresql://settlements_svc:settlements_svc_dev_pw@localhost:5433/youmart_dev?schema=settlements
# settlements_svc cannot read orders/sellers schemas (cross-schema
# isolation) - settleable items and seller identity/commission rate come
# over HTTP via @youmart/service-client (reuses ORDER_SERVICE_URL and
# SELLER_SERVICE_URL declared above).
# Settlement rule TOGGLES + PERCENTAGES (TEMPORARY env-backed source, same
# pattern as MARKETPLACE_MODE - Ch6's admin dashboard replaces this with a
# real settings table without changing the engine, see getSettlementRules()).
COMMISSION_ENABLED=true
COMMISSION_DEFAULT_PERCENT=10.00
TCS_ENABLED=true
TCS_PERCENT=1.00
TDS_ENABLED=false
TDS_PERCENT=0.00
# Cron pattern (BullMQ repeatable job) for the scheduled weekly settlement
# run - config-driven so dev can use a short interval without a code change.
SETTLEMENT_SCHEDULE_CRON=0 0 * * 1

# --- Logistics service ---
# Port the logistics service listens on. Named LOGISTICS_PORT (not PORT)
# for the same shared-root-.env reason as the other services' <X>_PORT vars.
LOGISTICS_PORT=4009
# Connection string using the logistics_svc role (Ch2 grants + a Ch5.4
# migration extending it to ALSO cover the tracking schema - shipment +
# tracking_event are one bounded context this service owns together, see
# packages/db/prisma/migrations/20260921090000_logistics_svc_tracking_schema_grant).
LOGISTICS_DATABASE_URL=postgresql://logistics_svc:logistics_svc_dev_pw@localhost:5433/youmart_dev?schema=logistics
# logistics_svc cannot read the orders/sellers schemas (cross-schema
# isolation) - order-item state/ownership and seller identity/activation
# come over HTTP via @youmart/service-client (reuses ORDER_SERVICE_URL and
# SELLER_SERVICE_URL declared above).
# Multi-courier FOUNDATION (Ch5.4): selects the registered ShippingProvider
# used for shipment creation. "manual" (ManualProvider) is the ONLY
# provider at launch - real courier adapters (Delhivery, Shiprocket, ...)
# register under their own name post-launch without changing this default.
DEFAULT_SHIPPING_PROVIDER=manual
# logistics_svc cannot read the auth schema either (cross-schema
# isolation) - resolving the buyer's email for the shipping-update
# notification (Ch6.2) goes over HTTP too (reuses AUTH_SERVICE_URL
# declared above in the order-service block).

# --- Returns service ---
# Port the returns service listens on. Named RETURNS_PORT (not PORT) for
# the same shared-root-.env reason as the other services' <X>_PORT vars.
RETURNS_PORT=4010
# Connection string using the least-privilege returns_svc role (Ch2
# grants), scoped to the returns schema only - not the owner DATABASE_URL
RETURNS_DATABASE_URL=postgresql://returns_svc:returns_svc_dev_pw@localhost:5433/youmart_dev?schema=returns
# returns_svc cannot read orders/payments/inventory schemas (cross-schema
# isolation) - order-item state, refunds, and stock all come over HTTP via
# @youmart/service-client (reuses ORDER_SERVICE_URL/INVENTORY_SERVICE_URL declared above).
PAYMENT_SERVICE_URL=http://localhost:4006
# A DELIVERED item is returnable only within this many days of delivery.
RETURN_WINDOW_DAYS=7

# --- Address service ---
# Port the address service listens on. Named ADDRESS_PORT (not PORT) for
# the same shared-root-.env reason as the other services' <X>_PORT vars.
ADDRESS_PORT=4011
# Connection string using the least-privilege addresses_svc role (Ch6.1
# grants), scoped to the addresses schema only - not the owner DATABASE_URL
ADDRESS_DATABASE_URL=postgresql://addresses_svc:addresses_svc_dev_pw@localhost:5433/youmart_dev?schema=addresses

# --- Notification service ---
# Port the notification service listens on. Named NOTIFICATION_PORT (not
# PORT) for the same shared-root-.env reason as the other services' <X>_PORT vars.
NOTIFICATION_PORT=4012
# Connection string using the least-privilege notifications_svc role (Ch2
# grants), scoped to the notifications schema only - not the owner DATABASE_URL
NOTIFICATION_DATABASE_URL=postgresql://notifications_svc:notifications_svc_dev_pw@localhost:5433/youmart_dev?schema=notifications
# Master switch (Ch6.2): false = log-only/simulated sends, NO real MSG91/
# Zoho calls - the dev/test-safe default so the whole enqueue->render->log
# pipeline can be exercised without spending SMS/WhatsApp credits or
# hitting rate limits. Flip to true only when you want REAL sends.
NOTIFICATIONS_ENABLED=false
# MSG91 (WhatsApp v5 bulk API - 5 final approved templates, Ch6.2c) - set
# your own MSG91 account's values; never commit real ones. Template NAMES
# are not secret (only MSG91_AUTH_KEY is) - a rename is an env change here,
# never a code change.
MSG91_AUTH_KEY=changeme_msg91_auth_key
MSG91_INTEGRATED_NUMBER=changeme_msg91_whatsapp_integrated_number
# Shared WhatsApp Business namespace for every UTILITY template below.
MSG91_WHATSAPP_NAMESPACE=changeme_msg91_whatsapp_template_namespace
# AUTHENTICATION-category template for OTP - a SEPARATE, pre-approved
# template from the UTILITY ones below (an order/marketing template
# CANNOT carry an OTP; Meta rejects it).
MSG91_WHATSAPP_OTP_TEMPLATE=youmart_login_otp
# Optional - only set if the OTP auth template was approved under a
# DIFFERENT namespace than MSG91_WHATSAPP_NAMESPACE; otherwise leave blank
# to reuse it.
MSG91_WHATSAPP_OTP_NAMESPACE=
# UTILITY templates - one per notification event (Ch6.2c final set):
# "Hi {{1}}, thank you for your order! Your order {{2}} is confirmed.
# Total: Rs {{3}}. We'll let you know when it ships."
MSG91_WHATSAPP_ORDER_PLACED_TEMPLATE=youmart_order_placed
# "Hi {{1}}, your YouMart order {{2}} has shipped! Track it with AWB {{3}}
# via {{4}}."
MSG91_WHATSAPP_ORDER_SHIPPED_TEMPLATE=youmart_order_shipped
# "Hi {{1}}, your YouMart order {{2}} has been delivered. Thank you for
# shopping with us!"
MSG91_WHATSAPP_ORDER_DELIVERED_TEMPLATE=youmart_order_delivered
# "Hi {{1}}, your refund of Rs {{2}} for order {{3}} has been processed.
# It will reflect in 5-7 business days."
MSG91_WHATSAPP_REFUND_TEMPLATE=youmart_refund_processed
# Sender id for MSG91's legacy plain-text SMS API - SMS is DROPPED as an
# active routing target (WhatsApp+email only); kept for a possible future
# fallback, not read by any template today.
MSG91_SENDER_ID=changeme_msg91_sender_id
# Optional - only needed if your MSG91 account has more than one
# registered OTP template. Unused now that OTP routes over WhatsApp.
MSG91_OTP_TEMPLATE_ID=
# Zoho Mail (transactional email via OAuth refresh-token flow) - set your
# own Zoho API console app's values; never commit real ones.
ZOHO_CLIENT_ID=changeme_zoho_client_id
ZOHO_CLIENT_SECRET=changeme_zoho_client_secret
ZOHO_REFRESH_TOKEN=changeme_zoho_refresh_token
ZOHO_FROM_EMAIL=changeme@yourdomain.example
# Zoho data-center region suffix (.com / .in / .eu / .com.au / .jp).
ZOHO_ACCOUNT_REGION=in
# The numeric Zoho Mail account id the "send message" endpoint requires -
# not obtainable from the OAuth flow alone, look it up via Zoho Mail's own
# accounts API/UI once.
ZOHO_ACCOUNT_ID=changeme_zoho_mail_account_id

# --- Search service (Ch6.3) ---
# Port the search service listens on. Named SEARCH_PORT (not PORT) for the
# same shared-root-.env reason as the other services' <X>_PORT vars.
SEARCH_PORT=4013
# search-service is NOT a Postgres client (no schema, no _svc role, no
# <X>_DATABASE_URL here) - Typesense is its only datastore, and Postgres
# (via catalog-service) remains the source of truth it reads FROM over
# HTTP (CATALOG_SERVICE_URL, already declared for other services).
# TYPESENSE_HOST/TYPESENSE_PROTOCOL default to localhost/http in code.
# Cron schedule (BullMQ repeatable job) for the nightly full-reindex safety
# net - 2 AM daily by default.
FULL_REINDEX_SCHEDULE_CRON=0 2 * * *
