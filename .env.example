# --- PostgreSQL ---
# Superuser/app username Postgres creates on first boot
POSTGRES_USER=youmart_dev
# Superuser/app password - placeholder only, never commit a real secret here
POSTGRES_PASSWORD=changeme_dev_password
# Default database created on first boot
POSTGRES_DB=youmart_dev
# Host port mapped to the Postgres container's 5432 (5433 - not 5432 - to avoid clashing with a native Windows PostgreSQL install already using 5432 on this machine)
POSTGRES_PORT=5433
# Full Prisma connection string for the local Postgres container (schema=public is the default connection schema; multiSchema tables live in their own named schemas)
DATABASE_URL=postgresql://youmart_dev:changeme_dev_password@localhost:5433/youmart_dev?schema=public

# --- Redis ---
# Host port mapped to the Redis container's 6379
REDIS_PORT=6379
# Hostname the queue's ioredis client connects to
REDIS_HOST=localhost
# Full Redis connection URL; if set, takes precedence over REDIS_HOST/REDIS_PORT
REDIS_URL=redis://localhost:6379

# --- Typesense ---
# API key Typesense requires on every request - placeholder only
TYPESENSE_API_KEY=changeme_dev_typesense_key
# Host port mapped to the Typesense container's 8108
TYPESENSE_PORT=8108
