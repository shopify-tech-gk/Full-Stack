# YouMart mobile — Expo API URL (copy to `.env`; `.env` is gitignored)
#
# The gateway `/api` base URL. Dev default is http://localhost:4000/api, but a REAL phone running
# Expo Go cannot reach your PC's "localhost" — point this at your PC's LAN IP on the same wifi:
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:4000/api
# (find your IP with `ipconfig` -> IPv4 Address). Or use a tunnel (see README).
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Brand logos in the category screen come from the Brandfetch Logo API (free, hotlinked).
# Client ID from https://developers.brandfetch.com (it is public: it ships inside logo URLs).
# Without it, brands show styled name tiles instead of logos.
EXPO_PUBLIC_BRANDFETCH_CLIENT_ID=